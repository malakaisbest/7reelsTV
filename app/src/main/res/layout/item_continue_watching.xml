<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="122dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_card_selector"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- Thumbnail Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="76dp">

            <ImageView
                android:id="@+id/cwThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="#1E293B" />

            <!-- Episode Badge (e.g. S1:E2) -->
            <TextView
                android:id="@+id/cwEpisodeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="4dp"
                android:background="@drawable/bg_indicator"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1dp"
                android:textColor="@color/brand_emerald_light"
                android:textSize="8sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Play Overlay Icon -->
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_media_play"
                android:alpha="0.85"
                app:tint="@color/white" />

            <!-- Progress Bar at bottom of thumbnail -->
            <ProgressBar
                android:id="@+id/cwProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="bottom"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/brand_emerald"
                android:progressBackgroundTint="#4B5563" />

        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/cwTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginHorizontal="2dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Position & Remaining Time -->
        <TextView
            android:id="@+id/cwTimeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:layout_marginHorizontal="2dp"
            android:textColor="@color/brand_emerald_light"
            android:textSize="8sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</FrameLayout>
