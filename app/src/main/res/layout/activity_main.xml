<?xml version="1.0" encoding="utf-8"?>
<com.malakaonline.tv7reals.CursorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cursorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- Primary Content Container -->
    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Dedicated 7reels WebView -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <!-- Native TV API Container -->
        <include layout="@layout/native_tv_view" />

        <!-- HTML5 Fullscreen Video Overlay Container -->
        <FrameLayout
            android:id="@+id/customViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:visibility="gone"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </FrameLayout>

    <!-- Top Loading Bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressBackgroundTint="#22FFFFFF"
        android:progressTint="@color/brand_accent"
        android:visibility="gone" />

    <!-- Corner Status Indicator for Virtual Cursor Mode -->
    <TextView
        android:id="@+id/cursorIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_indicator"
        android:text="@string/cursor_on"
        android:textColor="@color/brand_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Virtual Mouse Pointer View -->
    <ImageView
        android:id="@+id/cursorView"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_cursor"
        android:visibility="gone"
        android:importantForAccessibility="no" />

</com.malakaonline.tv7reals.CursorLayout>
