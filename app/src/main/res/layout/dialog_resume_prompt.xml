<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="420dp"
    android:layout_height="wrap_content"
    android:background="#0A0E17"
    android:padding="24dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/textResumeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Resume Watching"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textResumeSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="You left off at 14:32. How would you like to watch?"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Progress indicator bar in dialog -->
    <ProgressBar
        android:id="@+id/progressResume"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="@color/brand_emerald"
        android:progressBackgroundTint="#374151" />

    <!-- Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnResumeStartOver"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="14dp"
            android:text="⏪ Start Over"
            android:textColor="#E5E7EB"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnResumePlay"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_tv_button"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="18dp"
            android:text="⏩ Resume"
            android:textColor="@color/brand_emerald_light"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>
